# Every setting docker-compose.yml reads, with example values only.
# Copy this file to .env (in this folder) and replace the values marked
# change-me. .env is ignored by Git: never commit real passwords or secrets.

# PostgreSQL user and password. The database is created with these the first
# time it starts. Changing them later does not change an existing database:
# see the README.
DB_USER=opsdesk
DB_PASSWORD=change-me-to-a-real-password

# Signs login tokens. At least 32 characters. Make one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-characters

# Optional. The address you open the app at, which the backend must allow.
ALLOWED_ORIGIN=http://localhost:3000

# Optional. The backend's address as the browser sees it. It is built into the
# frontend: after changing it, run docker compose up --build.
VITE_API_URL=http://localhost:8080/api/v1
